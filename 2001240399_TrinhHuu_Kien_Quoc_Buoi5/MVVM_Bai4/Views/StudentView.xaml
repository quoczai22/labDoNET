<Window x:Class="MVVM_Bai4.Views.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVM_Bai4.Views"
        xmlns:vm="clr-namespace:MVVM_Bai4.ModelViews"
        mc:Ignorable="d"
        Title="StudentView" Height="450" Width="800">

    <Window.DataContext>
            <vm:StudentViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ SINH VIÊN" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="10,0,10,0">
                <TextBlock Text="Họ và tên" FontWeight="Bold"/>
                <TextBlock Text="Giới tính" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBox Width="200" Text="{Binding NewName, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Nam" GroupName="Gender" IsChecked="{Binding IsMale, Mode=TwoWay}"/>
                    <RadioButton Content="Nữ" GroupName="Gender" IsChecked="{Binding IsFemale, Mode=TwoWay}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Tuổi" FontWeight="Bold"/>
                <TextBlock Text="Thành phố" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel>
                <TextBox Width="200" Text="{Binding NewAge, Mode=TwoWay}"/>
                <ComboBox Width="200" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}">
                    <ComboBoxItem Content="Hà Nội"/>
                    <ComboBoxItem Content="Hồ Chí Minh"/>
                    <ComboBoxItem Content="Đà Nẵng"/>
                    <ComboBoxItem Content="Hải Phòng"/>
                    <ComboBoxItem Content="Cần Thơ"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Thêm" Width="80" Height="30" Click="BtnAdd_Click" Margin="0,0,10,0" Background="Green" Foreground="White"/>
            <Button Content="Xóa" Width="80" Click="BtnDelete_Click" Margin="10,0,0,0" Background="Red" Foreground="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <TextBlock Text="Tìm theo tên:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="180" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding StudentCount, StringFormat='Tổng số sinh viên: {0}'}" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView Grid.Row="4" ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Họ tên" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Tuổi" Width="60" DisplayMemberBinding="{Binding Age}" />
                    <GridViewColumn Header="Giới tính" Width="80" DisplayMemberBinding="{Binding Gender}" />
                    <GridViewColumn Header="Thành phố" Width="120" DisplayMemberBinding="{Binding City}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</Window>
