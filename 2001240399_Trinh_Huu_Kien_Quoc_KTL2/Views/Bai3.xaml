<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_KTL2.Views.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2001240399_Trinh_Huu_Kien_Quoc_KTL2.Views"
        mc:Ignorable="d"
        Title="Bai3" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Thông tin đặt phòng" Grid.Column="0" Margin="0,0,10,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ngày đặt phòng:" Grid.Row="0" Margin="0,5,0,15"/>
                <TextBlock Text="{Binding NgayDatPhong}" Grid.Row="0" Grid.Column="1" Margin="0,5,0,15" FontWeight="Bold" Foreground="Red"/>

                <TextBlock Text="Chọn phòng:" Grid.Row="1" Margin="0,0,0,15"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" Height="25"
                          ItemsSource="{Binding DanhSachPhong}" DisplayMemberPath="TenPhong" SelectedItem="{Binding SelectedPhong, Mode=TwoWay}"/>

                <TextBlock Text="Giá phòng:" Grid.Row="2" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding GiaPhongDTO}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,15"/>

                <TextBlock Text="Sức chứa:" Grid.Row="3" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding SucChuaDTO}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,15"/>

                <TextBlock Text="Chọn khách hàng:" Grid.Row="4" Margin="0,0,0,15"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,15" Height="25"
                          ItemsSource="{Binding DanhSachKhachHang}" DisplayMemberPath="TenKH" SelectedItem="{Binding SelectedKhachHang, Mode=TwoWay}"/>

                <TextBlock Text="Giờ vào:" Grid.Row="5" Margin="0,0,0,15"/>
                <TextBox Text="{Binding GioVaoDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="0,0,0,15" Height="25"/>

                <TextBlock Text="Giờ ra:" Grid.Row="6" Margin="0,0,0,15"/>
                <TextBox Text="{Binding GioRaDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="0,0,0,15" Height="25"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Thông tin phụ thu" Grid.Column="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Chọn phụ thu:" VerticalAlignment="Center" Width="85"/>
                    <ComboBox Width="120" Height="25" Margin="0,0,10,0"
                              ItemsSource="{Binding DanhSachPhuThu}" DisplayMemberPath="TenPhuThu" SelectedItem="{Binding SelectedPhuThu, Mode=TwoWay}"/>

                    <TextBlock Text="Giá:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding GiaPhuThuDTO}" VerticalAlignment="Center" Width="60"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Số lượng:" VerticalAlignment="Center" Width="85"/>
                    <TextBox Width="120" Height="25" Margin="0,0,10,0" Text="{Binding SsoLuongDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Thêm" Command="{Binding ThemPhuThuCommand}" Width="70" Height="25" Background="#E0E0E0"/>
                </StackPanel>

                <TextBlock Text="Danh sách phụ thu" Grid.Row="2" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid Grid.Row="2" Margin="0,20,0,10" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding DanhSachChiTietPhuThu}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phụ thu" Binding="{Binding MaPhuThu}" Width="80"/>
                        <DataGridTextColumn Header="Tên phụ thu" Binding="{Binding TenPhuThu}" Width="150"/>
                        <DataGridTextColumn Header="Giá phụ thu" Binding="{Binding GiaPhuThu}" Width="100"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock Text="Tổng tiền tạm tính" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding TongTienTamTinh, Mode=OneWay, StringFormat={}{0:N0}}" Width="120" Height="25" IsReadOnly="True" Margin="0,0,10,0"/>
                    <Button Content="Đặt phòng" Command="{Binding DatPhongCommand}" Width="90" Height="30" Background="#E0E0E0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
