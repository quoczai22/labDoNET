<Window x:Class="MVVM_Bai5.Views.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVM_Bai5.Views"
        xmlns:vm="clr-namespace:MVVM_Bai5.ViewModels"
        mc:Ignorable="d"
        Title="StudentView" Height="450" Width="800">
    
    <Window.DataContext>
        <vm:StudentViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Danh sách sinh viên">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="QUẢN LÝ SINH VIÊN" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Margin="10,0,10,0">
                            <TextBlock Text="Họ và tên" FontWeight="Bold"/>
                            <TextBlock Text="Giới tính" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBox Width="200" Text="{Binding NewName, Mode=TwoWay}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Nam" GroupName="Gender" IsChecked="{Binding IsMale, Mode=TwoWay}"/>
                                <RadioButton Content="Nữ" GroupName="Gender" IsChecked="{Binding IsFemale, Mode=TwoWay}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tuổi" FontWeight="Bold"/>
                            <TextBlock Text="Thành phố" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox Width="200" Text="{Binding NewAge, Mode=TwoWay}"/>
                            <ComboBox Width="200" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" Margin="10" >
                        <Button Content="Thêm" Width="80"  Click="BtnAdd_Click" Margin="50,0,0,0"/>
                        <Button Content="Sửa" Width="80" Click="BtnEdit_Click" Margin="50,0,0,0"/>
                        <Button Content="Xóa" Width="80" Click="BtnDelete_Click" Margin="50,0,0,0"/>
                        <Button Content="Undo" Width="80" Click="BtnUndo_Click" Margin="50,0,0,0"/>
                        <Button Content="Redo" Width="80" Click="BtnRedo_Click" Margin="50,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="Tìm theo tên:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="180" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Tổng: Nam {0} Nữ {1}">
                                    <Binding Path="StudentCountMale"/>
                                    <Binding Path="StudentCountFemale"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <ListView Grid.Row="4" ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Họ tên" Width="200" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Tuổi" Width="60" DisplayMemberBinding="{Binding Age}" />
                                <GridViewColumn Header="Giới tính" Width="80" DisplayMemberBinding="{Binding Gender}" />
                                <GridViewColumn Header="Thành phố" Width="120" DisplayMemberBinding="{Binding City}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Lưu/Load file">
                <StackPanel Margin="20">
                    <Button Content="Lưu JSON" Width="120" Click="BtnSave_Click" Margin="0,0,0,10"/>
                    <Button Content="Load JSON" Width="120" Click="BtnLoad_Click"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,20,0,0" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
