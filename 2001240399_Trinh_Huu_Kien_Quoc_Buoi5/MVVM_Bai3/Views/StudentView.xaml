<Window x:Class="MVVM_Bai3.Views.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MVVM_Bai3.ViewModels"
        Title="Danh sách sinh viên động" Height="450" Width="800" MinWidth="700">

    <Window.DataContext>
        <local:StudentViewModel_Ob/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="588*"/>
            <ColumnDefinition Width="139*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Danh sách sinh viên"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="269,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,300" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Họ và tên" FontWeight="Bold"/>
                    <TextBox Width="180" Text="{Binding NewName, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Tuổi" FontWeight="Bold"/>
                    <TextBox Width="60" Text="{Binding NewAge, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Thêm" Width="80" Click="BtnAdd_Click" Margin="0,0,8,0"/>
                <Button Content="Xóa" Width="80" Click="BtnDelete_Click" Margin="0,0,8,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="180" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Sắp xếp" Width="80" Click="BtnSort_Click" Margin="0,0,8,0"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="2"
          ItemsSource="{Binding StudentsView}"
          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
          BorderThickness="1" Height="295" VerticalAlignment="Top" Margin="0,72,0,0" Grid.ColumnSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Họ và tên" Width="400" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Tuổi" Width="100" DisplayMemberBinding="{Binding Age}" />
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
