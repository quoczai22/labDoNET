<Window x:Class="Trinh_Huu_Kien_Quoc_2001240399_KT1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trinh_Huu_Kien_Quoc_2001240399_KT1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Họ và tên:" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox x:Name="txtHoTen" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,20,15" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Nghề nghiệp:" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox x:Name="txtNgheNghiep" Grid.Row="1" Grid.Column="3" Height="22" Margin="0,0,0,15" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Giới tính:" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,15">
            <RadioButton x:Name="radNam" Content="Nam" Margin="0,0,15,0" IsChecked="True"/>
            <RadioButton Content="Nữ"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Quốc tịch:" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <ComboBox x:Name="cboQuocTich" Grid.Row="2" Grid.Column="3" Height="22" Margin="0,0,0,15">
            <ComboBoxItem Content="Việt Nam" IsSelected="True"/>
            <ComboBoxItem Content="Mỹ"/>
            <ComboBoxItem Content="Nhật"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ngày sinh:" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <DatePicker x:Name="dpNgaySinh" Grid.Row="3" Grid.Column="1" Height="22" Margin="0,0,20,15" HorizontalAlignment="Left" Width="180"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Sở thích:" VerticalAlignment="Top" Margin="0,0,10,15"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,20,15">
            <CheckBox x:Name="chkDocSach" Content="Đọc sách" Margin="0,0,0,5"/>
            <CheckBox x:Name="chkNgheNhac" Content="Nghe nhạc" Margin="0,0,0,5"/>
            <CheckBox x:Name="chkTheThao" Content="Thể thao" Margin="0,0,0,5"/>
            <CheckBox x:Name="chkDuLich" Content="Du lịch"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Kỹ năng:" VerticalAlignment="Top" Margin="0,0,10,15"/>
        <ListBox x:Name="lstKyNang" Grid.Row="5" Grid.Column="1" Height="80" Margin="0,0,20,15" SelectionMode="Multiple">
            <ListBoxItem Content="C#"/>
            <ListBoxItem Content="Java"/>
            <ListBoxItem Content="Python"/>
            <ListBoxItem Content="Web"/>
        </ListBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button Content="Xem thông tin" Width="110" Height="28" Margin="0,0,20,0" Background="#E1E1E1" Click="btnXemThongTin_Click"/>
            <Button Content="Thoát" Width="110" Height="28" Background="#E1E1E1" Click="btnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
