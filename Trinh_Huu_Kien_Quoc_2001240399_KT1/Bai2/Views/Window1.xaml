<Window x:Class="Bai2.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai2.Views"
        xmlns:vm="clr-namespace:Bai2.ViewModels"
        mc:Ignorable="d"
        Title="Thanh toán phòng thuê" Height="650" Width="900">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="THANH TOÁN PHÒNG THUÊ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên khách hàng:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TenKhachHang, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Số ngày lưu trú:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SoNgayLuuTruText, UpdateSourceTrigger=PropertyChanged}" Height="25" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Loại phòng" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding DanhSachLoaiPhong}"
                          DisplayMemberPath="Ten"
                          SelectedItem="{Binding SelectedRoomType}"
                          Width="150" HorizontalAlignment="Left" Height="25"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Tiện nghi" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding DanhSachTienNghi}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Ten}" IsChecked="{Binding IsSelected}" Margin="0,0,0,5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Dịch vụ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding DanhSachDichVu}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Ten}" IsChecked="{Binding IsSelected}" Margin="0,0,0,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Content="Thanh toán" Command="{Binding ThanhToanCommand}" Width="90" Height="30" Margin="0,0,15,0"/>
            <Button Content="Xóa dòng" Command="{Binding XoaDongCommand}" Width="90" Height="30" Margin="0,0,15,0"/>
            <Button Content="Nhập mới" Command="{Binding NhapMoiCommand}" Width="90" Height="30" Margin="0,0,15,0"/>
            <Button Content="Thoát" Command="{Binding ThoatCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="90" Height="30"/>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding DanhSachHoaDon}" SelectedItem="{Binding SelectedBill}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="40"/>
                <DataGridTextColumn Header="Tên khách" Binding="{Binding TenKhach}" Width="120"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding LoaiPhong}" Width="100"/>
                <DataGridTextColumn Header="Tiện nghi" Binding="{Binding TienNghi}" Width="150"/>
                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding DichVu}" Width="150"/>
                <DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgay}" Width="60"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Vertical">
            <TextBlock Text="Thống kê" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Tổng số lượt khách: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TongLuotKhach}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tổng doanh thu: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TongDoanhThu, StringFormat={}{0:N0} đ}" Foreground="Red"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
