<Window x:Class="Bai4.Views.QuanLyMonHocView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai4.Views"
        mc:Ignorable="d"
        Title="QuanLyMonHocView" Height="450" Width="800">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quản lý Môn học" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="0,0,0,25"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Mã môn:" VerticalAlignment="Center" Margin="0,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,8"
                     Text="{Binding MaMon, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="0" Grid.Column="3" Content="Tên môn học:" VerticalAlignment="Center" Margin="0,8"/>
            <TextBox Grid.Row="0" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,8"
                     Text="{Binding TenMonHoc, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Số TC:" VerticalAlignment="Center" Margin="0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,8"
                     Text="{Binding SoTC, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="1" Grid.Column="3" Content="Tính chất:" VerticalAlignment="Center" Margin="0,8"/>
            <ComboBox Grid.Row="1" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Margin="0,8"
                      ItemsSource="{Binding DS_TinhChat}" SelectedItem="{Binding SelectedTinhChat}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="80,0,0,25">
            <Button Content="Thêm" Width="95" Height="30" Margin="0,0,15,0" Command="{Binding ThemCommand}"/>
            <Button Content="Sửa" Width="95" Height="30" Margin="0,0,15,0" Command="{Binding SuaCommand}"/>
            <Button Content="Xóa" Width="95" Height="30" Margin="0,0,15,0" Command="{Binding XoaCommand}"/>
            <Button Content="Lưu" Width="95" Height="30" Margin="0,0,15,0" Command="{Binding LuuCommand}"/>
            <Button Content="Hủy" Width="95" Height="30" Command="{Binding HuyCommand}"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#B2BCC6" BorderThickness="1">
            <DataGrid ItemsSource="{Binding DS_MonHoc}" SelectedItem="{Binding SelectedMonHoc}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Số TC" Binding="{Binding SoTC}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tính chất" Binding="{Binding TinhChat}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Background" Value="#F4F6F9"/>
                        <Setter Property="BorderBrush" Value="#B2BCC6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </Grid>
</Window>
