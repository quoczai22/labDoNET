<Window x:Class="Bai5.Views.QuanLyMonHocView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai5.Views"
        mc:Ignorable="d"
        Title="QuanLyMonHocView" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Margin="0,0,0,15" BorderBrush="#BCBCBC" BorderThickness="1" Background="White">
            <GroupBox.Header>
                <TextBlock Text="Thông tin môn học" FontWeight="Bold" FontSize="15" Foreground="#333"/>
            </GroupBox.Header>

            <StackPanel Margin="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Label Content="Mã môn:" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                             Text="{Binding MaMH, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding IsReadOnlyMaMon}"/>

                    <Label Content="Tên môn học:" Grid.Column="3" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding TenMH, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding IsReadOnlyTenMon}"/>

                    <Label Content="Số TC:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding SoTinChi, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Tính chất:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="4" Height="28" VerticalContentAlignment="Center"
                      ItemsSource="{Binding DS_TinhChat}"
                      SelectedItem="{Binding TinhChat}"></ComboBox> 
                </Grid>

                <UniformGrid Rows="1" Columns="5" Height="35" Margin="50,20,50,5">
                    <Button Content="Thêm" Margin="5,0" Command="{Binding AddCommand}" Background="#E1E1E1"/>
                    <Button Content="Sửa" Margin="5,0" Command="{Binding EditCommand}" Background="#E1E1E1"/>
                    <Button Content="Xóa" Margin="5,0" Command="{Binding DeleteCommand}" Background="#E1E1E1"/>
                    <Button Content="Lưu" Margin="5,0" Command="{Binding SaveCommand}" Background="#E1E1E1"/>
                    <Button Content="Hủy" Margin="5,0" Command="{Binding CancelCommand}" Background="#E1E1E1"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" BorderBrush="#BCBCBC" BorderThickness="1" Background="White">
            <GroupBox.Header>
                <TextBlock Text="Danh sách môn học" FontWeight="Bold" FontSize="15" Foreground="#333"/>
            </GroupBox.Header>

            <DataGrid Margin="10" AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      ItemsSource="{Binding DS_MonHoc}"
                      SelectedItem="{Binding SelectedMonHoc}"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      Background="#FAFAFA" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="120"/>
                    <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="*"/>
                    <DataGridTextColumn Header="Số TC" Binding="{Binding SoTC}" Width="100"/>
                    <DataGridTextColumn Header="Tính chất" Binding="{Binding TinhChat}" Width="150"/>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
