<Window x:Class="Bai4.Views.DanhSachSinhVienView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai4.Views"
        mc:Ignorable="d"
        Title="DanhSachSinhVienView" Height="550" Width="1000">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Margin="0,0,15,0" BorderBrush="#D3D3D3" BorderThickness="1" Background="White">
            <GroupBox.Header>
                <TextBlock Text="THÔNG TIN SINH VIÊN" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="5,0"/>
            </GroupBox.Header>

            <DockPanel LastChildFill="True" Margin="15,10">
                <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="5" Height="35" Margin="0,20,0,5">
                    <Button Content="Thêm" Margin="0,0,5,0" Command="{Binding AddCommand}" Background="#E1E1E1"/>
                    <Button Content="Sửa" Margin="0,0,5,0" Command="{Binding UpdateCommand}" Background="#E1E1E1"/>
                    <Button Content="Xóa" Margin="0,0,5,0" Command="{Binding DeleteCommand}" Background="#E1E1E1"/>
                    <Button Content="Lưu" Margin="0,0,5,0" Command="{Binding SaveCommand}" Background="#E1E1E1"/>
                    <Button Content="Hủy" Command="{Binding CancelCommand}" Background="#E1E1E1"/>
                </UniformGrid>

                <StackPanel>
                    <Label Content="Mã sinh viên:" Margin="0,5,0,0"/>
                    <TextBox Height="30" VerticalContentAlignment="Center" Padding="5,0" 
                           Text="{Binding MaSV, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding IsMaSVEnabled}"/>

                    <Label Content="Họ tên:" Margin="0,10,0,0"/>
                    <TextBox Height="30" VerticalContentAlignment="Center" Padding="5,0"
                           Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Giới tính:" Margin="0,10,0,0"/>
                    <ComboBox Height="30" VerticalContentAlignment="Center" 
                            SelectedValuePath="Content"
                            SelectedValue="{Binding GioiTinh}">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                    </ComboBox>

                    <Label Content="Ngày sinh:" Margin="0,10,0,0"/>
                    <DatePicker Height="30" VerticalContentAlignment="Center"
                              SelectedDate="{Binding NgaySinh}"/>

                    <Label Content="Lớp:" Margin="0,10,0,0"/>
                    <ComboBox Height="30" VerticalContentAlignment="Center"
                            ItemsSource="{Binding DS_Lop}"
                            SelectedValuePath="MaLop"
                            DisplayMemberPath="TenLop"
                            SelectedValue="{Binding SelectedMaLop}">
                        
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" BorderBrush="#D3D3D3" BorderThickness="1" Background="White">
            <GroupBox.Header>
                <TextBlock Text="DANH SÁCH SINH VIÊN" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="5,0"/>
            </GroupBox.Header>

            <Grid Margin="10">
                <DataGrid AutoGenerateColumns="False" 
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        RowHeight="30"
                        FontSize="13"
                        ItemsSource="{Binding DS_SinhVien}"
                        SelectedItem="{Binding SelectedSinhVien}"
                        BorderThickness="1" BorderBrush="#EEEEEE">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSinhVien}" Width="80"/>
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                        <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="80"/>
                        <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Mã lớp" Binding="{Binding MaLop}" Width="80"/>
                    </DataGrid.Columns>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
