<Window x:Class="Bai2.Views.UngDungQuanLyDiem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai2.Views"
        mc:Ignorable="d"
        Title="UngDungQuanLyDiem" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Danh mục">
                <MenuItem Header="Khoa" Click="MenuKhoa_Click"/>
            </MenuItem>
            <MenuItem Header="Hệ thống">
                <MenuItem Header="Thoát" Click="MenuThoat_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Sẵn sàng"/>
        </StatusBar>

        <ContentControl x:Name="MainContent" Margin="10" />
    </DockPanel>
</Window>
