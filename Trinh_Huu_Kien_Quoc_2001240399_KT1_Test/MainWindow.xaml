<Window x:Class="Trinh_Huu_Kien_Quoc_2001240399_KT1_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trinh_Huu_Kien_Quoc_2001240399_KT1_Test"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mã sinh viên:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtMaSV" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Họ tên:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtHoTen" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Giới tính:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <RadioButton x:Name="radNam" Content="Nam" Margin="0,0,20,0" IsChecked="True"/>
            <RadioButton x:Name="radNu" Content="Nữ"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Sở thích:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <CheckBox x:Name="chkTheThao" Content="Thể thao" Margin="0,0,20,0"/>
            <CheckBox x:Name="chkAmNhac" Content="Âm nhạc" Margin="0,0,20,0"/>
            <CheckBox x:Name="chkDuLich" Content="Du lịch"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Lớp:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="cboLop" Grid.Row="5" Grid.Column="1" Height="25" Margin="0,0,0,10" SelectedIndex="0">
            <ComboBoxItem Content="15DH01"/>
            <ComboBoxItem Content="15DH02"/>
            <ComboBoxItem Content="15DH03"/>
            <ComboBoxItem Content="15DH04"/>
        </ComboBox>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Môn học:" VerticalAlignment="Top" Margin="0,0,10,10"/>
        <ListBox x:Name="lstMonHoc" Grid.Row="6" Grid.Column="1" Margin="0,0,0,20" SelectionMode="Multiple">
            <ListBoxItem Content="Lập trình C#"/>
            <ListBoxItem Content="Cơ sở dữ liệu"/>
            <ListBoxItem Content="WPF"/>
        </ListBox>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnLuu" Content="Lưu" Width="100" Height="30" Margin="0,0,20,0" Background="#E1E1E1" Click="btnLuu_Click"/>
            <Button x:Name="btnThoat" Content="Thoát" Width="100" Height="30" Background="#E1E1E1" Click="btnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
