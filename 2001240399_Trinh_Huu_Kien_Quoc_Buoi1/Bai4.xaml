<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi1.Bai4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2001240399_Trinh_Huu_Kien_Quoc_Buoi1"
        mc:Ignorable="d"
        Title="Bai4" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Họ tên:" Grid.Row="0" Grid.Column="0" Margin="8,8,5,0"/>
        <TextBox x:Name="txtten" Grid.Row="0" Grid.Column="1" Width="300"
             Margin="0,0,0,5" Background="LightPink" HorizontalAlignment="Left"/>

        <TextBlock Text="Tuổi:" Grid.Row="1" Grid.Column="0" Margin="8,8,5,0"/>
        <TextBox x:Name="txttuoi" Grid.Row="1" Grid.Column="1" Width="300"
             Margin="0,0,0,5" Background="LightPink" HorizontalAlignment="Left"/>

        <Button Content="Gửi" Grid.Row="2" Grid.Column="1" Width="100"
            HorizontalAlignment="Left" Click="btn_click"/>

        <TextBlock x:Name="showkq" Grid.Row="3" Grid.Column="1"
               Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>


</Window>
