<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_KT2L2.Views.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bài 3 - Đặt phòng khách sạn" Height="520" Width="960">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Thông tin đặt phòng" Padding="10" Margin="0,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ngày đặt:" Grid.Row="0" Margin="0,6"/>
                <TextBox Text="{Binding NgayDatPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,3"/>

                <TextBlock Text="Chọn phòng:" Grid.Row="1" Margin="0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="26" Margin="0,3"
                          ItemsSource="{Binding DanhSachPhong}"
                          DisplayMemberPath="TenPhong"
                          SelectedItem="{Binding SelectedPhong, Mode=TwoWay}"/>

                <TextBlock Text="Giá phòng:" Grid.Row="2" Margin="0,6"/>
                <TextBlock Text="{Binding GiaPhongDTO}" Grid.Row="2" Grid.Column="1" Margin="0,6" FontWeight="Bold"/>

                <TextBlock Text="Sức chứa:" Grid.Row="3" Margin="0,6"/>
                <TextBlock Text="{Binding SucChuaDTO}" Grid.Row="3" Grid.Column="1" Margin="0,6" FontWeight="Bold"/>

                <TextBlock Text="Tình trạng:" Grid.Row="4" Margin="0,6"/>
                <TextBlock Text="{Binding TinhTrangDTO}" Grid.Row="4" Grid.Column="1" Margin="0,6" FontWeight="Bold"/>

                <TextBlock Text="Khách hàng:" Grid.Row="5" Margin="0,6"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Height="26" Margin="0,3"
                          ItemsSource="{Binding DanhSachKhachHang}"
                          DisplayMemberPath="TenKH"
                          SelectedItem="{Binding SelectedKhachHang, Mode=TwoWay}"/>

                <TextBlock Text="Giờ vào:" Grid.Row="6" Margin="0,6"/>
                <TextBox Text="{Binding GioVaoDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Height="26" Margin="0,3"/>

                <TextBlock Text="Giờ ra:" Grid.Row="7" Margin="0,6"/>
                <TextBox Text="{Binding GioRaDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" Height="26" Margin="0,3"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Thông tin dịch vụ" Grid.Column="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Dịch vụ:" VerticalAlignment="Center" Width="70"/>
                    <ComboBox Width="170" Height="26" Margin="0,0,14,0"
                              ItemsSource="{Binding DanhSachDichVu}"
                              DisplayMemberPath="TenDV"
                              SelectedItem="{Binding SelectedDichVu, Mode=TwoWay}"/>
                    <TextBlock Text="Giá:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding GiaDichVuDTO}" VerticalAlignment="Center" Width="90" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Số lượng:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Width="90" Height="26" Margin="0,0,14,0"
                             Text="{Binding SoLuongDTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Thêm dịch vụ" Width="110" Height="28" Command="{Binding ThemDichVuCommand}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding DanhSachChiTietDichVu}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã DV" Binding="{Binding MaDV}" Width="80"/>
                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding TenDV}" Width="180"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding GiaDV, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="60"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Text="Tổng tiền:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TongTienTamTinh, Mode=OneWay, StringFormat={}{0:N0}}" IsReadOnly="True" Width="130" Height="28" Margin="0,0,12,0"/>
                    <Button Content="Đặt phòng" Width="100" Height="32" Command="{Binding DatPhongCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
