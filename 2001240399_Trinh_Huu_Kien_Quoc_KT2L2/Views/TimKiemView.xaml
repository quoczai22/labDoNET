<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_KT2L2.Views.TimKiemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bài 2 - Tìm kiếm phòng" Height="360" Width="900">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Điều kiện tìm kiếm" Padding="10" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Loại phòng:" Grid.Row="0" VerticalAlignment="Center" Margin="0,5,8,10"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Height="26" Margin="0,5,0,10"
                          ItemsSource="{Binding DanhSachLoaiPhong}"
                          DisplayMemberPath="TenLoai"
                          SelectedItem="{Binding SelectedLoaiPhong, Mode=TwoWay}"/>

                <TextBlock Text="Sức chứa:" Grid.Row="1" VerticalAlignment="Center" Margin="0,5,8,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="26" Margin="0,5,0,10"
                         Text="{Binding SucChuaTimKiem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Tìm kiếm" Grid.Row="2" Grid.Column="1" Width="90" Height="28"
                        HorizontalAlignment="Left" Command="{Binding TimKiemCommand}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Danh sách phòng" Grid.Column="1" Padding="8" Margin="0,0,12,0">
            <ListBox ItemsSource="{Binding KetQuaTimKiem}"
                     SelectedItem="{Binding SelectedPhong, Mode=TwoWay}"
                     DisplayMemberPath="TenPhong"/>
        </GroupBox>

        <GroupBox Header="Chi tiết phòng" Grid.Column="2" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tên phòng:" Grid.Row="0" Margin="0,6"/>
                <TextBlock Text="{Binding ChiTietTenPhong}" Grid.Row="0" Grid.Column="1" Margin="0,6" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="Sức chứa:" Grid.Row="1" Margin="0,6"/>
                <TextBlock Text="{Binding ChiTietSucChua}" Grid.Row="1" Grid.Column="1" Margin="0,6" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="Giá:" Grid.Row="2" Margin="0,6"/>
                <TextBlock Text="{Binding ChiTietGiaPhong}" Grid.Row="2" Grid.Column="1" Margin="0,6" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="Loại phòng:" Grid.Row="3" Margin="0,6"/>
                <TextBlock Text="{Binding ChiTietLoaiPhong}" Grid.Row="3" Grid.Column="1" Margin="0,6" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="Tình trạng:" Grid.Row="4" Margin="0,6"/>
                <TextBlock Text="{Binding ChiTietTinhTrang}" Grid.Row="4" Grid.Column="1" Margin="0,6" FontWeight="Bold" Foreground="Red"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
