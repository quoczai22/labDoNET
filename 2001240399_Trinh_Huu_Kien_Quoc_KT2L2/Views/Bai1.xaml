<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_KT2L2.Views.Bai1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bài 1 - Quản lý phòng" Height="500" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Thông tin phòng" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Loại phòng:" Grid.Row="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Height="26" Margin="0,5,18,5"
                          ItemsSource="{Binding DanhSachLoaiPhong}"
                          DisplayMemberPath="TenLoai"
                          SelectedItem="{Binding SelectedLoaiPhong, Mode=TwoWay}"/>

                <TextBlock Text="Mã phòng:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,8,5"/>
                <TextBox Grid.Row="0" Grid.Column="3" Height="26" Margin="0,5,0,5"
                         Text="{Binding MaPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tên phòng:" Grid.Row="1" VerticalAlignment="Center" Margin="0,5,8,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="26" Margin="0,5,0,5"
                         Text="{Binding TenPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Sức chứa:" Grid.Row="2" VerticalAlignment="Center" Margin="0,5,8,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Height="26" Margin="0,5,18,5"
                         Text="{Binding SucChua, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Giá phòng:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,5,8,5"/>
                <TextBox Grid.Row="2" Grid.Column="3" Height="26" Margin="0,5,0,5"
                         Text="{Binding GiaPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tình trạng:" Grid.Row="3" VerticalAlignment="Center" Margin="0,8,8,5"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,5">
                    <RadioButton Content="Phòng trống" IsChecked="{Binding PhongTrong, Mode=TwoWay}" Margin="0,0,24,0"/>
                    <RadioButton Content="Khách đang nhận phòng" IsChecked="{Binding PhongDangNhan, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
            <Button Content="Thêm" Width="90" Height="32" Margin="5" Command="{Binding ThemCommand}"/>
            <Button Content="Xóa" Width="90" Height="32" Margin="5" Command="{Binding XoaCommand}"/>
            <Button Content="Sửa" Width="90" Height="32" Margin="5" Command="{Binding SuaCommand}"/>
            <Button Content="Làm mới" Width="90" Height="32" Margin="5" Command="{Binding LamMoiCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  ItemsSource="{Binding DanhSachPhong}"
                  SelectedItem="{Binding SelectedPhong, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phòng" Binding="{Binding MaPhong}" Width="100"/>
                <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}" Width="180"/>
                <DataGridTextColumn Header="Sức chứa" Binding="{Binding SucChua}" Width="80"/>
                <DataGridTextColumn Header="Giá phòng" Binding="{Binding GiaPhong, StringFormat={}{0:N0}}" Width="120"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding LOAIPHONG.TenLoai}" Width="150"/>
                <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
