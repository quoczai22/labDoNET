<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi2.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bai3" Height="436" Width="800">


    <Window.Resources>
        <Style x:Key="SeatSize" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="LemonChiffon"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
        
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Text="MÀN ẢNH"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="Orange"
                   HorizontalAlignment="Center"
                   Margin="0,20"/>


        <Border Grid.Row="1"
        CornerRadius="12"
        BorderBrush="LightBlue"
        BorderThickness="2"
        Padding="20"
        Margin="20">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="AntiqueWhite" Offset="0"/>
                    <GradientStop Color="LightGray" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid x:Name="SeatGrid"
              Grid.Row="0"
              HorizontalAlignment="Center" Margin="0,0,0,51" Grid.RowSpan="2" Width="696">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <Button Style="{StaticResource SeatSize}" Content="1" Tag="1000" Grid.Row="0" Grid.Column="0" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="2" Tag="1000" Grid.Row="0" Grid.Column="1" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="3" Tag="1000" Grid.Row="0" Grid.Column="2" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="4" Tag="1000" Grid.Row="0" Grid.Column="3" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="5" Tag="1000" Grid.Row="0" Grid.Column="4" Click="seat_click"/>


                    <Button Style="{StaticResource SeatSize}" Content="6" Tag="1500" Grid.Row="1" Grid.Column="0" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="7" Tag="1500" Grid.Row="1" Grid.Column="1" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="8" Tag="1500" Grid.Row="1" Grid.Column="2" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="9" Tag="1500" Grid.Row="1" Grid.Column="3" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="10" Tag="1500" Grid.Row="1" Grid.Column="4" Click="seat_click"/>


                    <Button Style="{StaticResource SeatSize}" Content="11" Tag="2000" Grid.Row="2" Grid.Column="0" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="12" Tag="2000" Grid.Row="2" Grid.Column="1" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="13" Tag="2000" Grid.Row="2" Grid.Column="2" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="14" Tag="2000" Grid.Row="2" Grid.Column="3" Click="seat_click"/>
                    <Button Style="{StaticResource SeatSize}" Content="15" Tag="2000" Grid.Row="2" Grid.Column="4" Click="seat_click"/>
                </Grid>


                <TextBlock Grid.Row="1"
                   Text="Chọn ghế để xem giá vé"
                   FontSize="16"
                   Margin="52,15,0,15"
                   HorizontalAlignment="Left"/>
                <TextBox x:Name="txt_tongtien" HorizontalAlignment="Left" Margin="242,0,0,0" Grid.Row="1"  Text="" VerticalAlignment="Center" Width="450" Height="31"/>


                <Grid Grid.Row="2" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Chọn"
                    Grid.Column="0"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,25,0" Click="chon"/>

                    <Button Content="Hủy"
                    Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,26,0" Click="huy"/>

                    <Button Content="Thoát"
                    Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}" Grid.ColumnSpan="2" Margin="238,0,26,0" Click="thoat"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>
