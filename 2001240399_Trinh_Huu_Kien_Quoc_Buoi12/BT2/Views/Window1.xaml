<Window x:Class="BT2.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BT2.Views"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="40">
            <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" FontSize="22" FontWeight="Bold"
HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#2C3E50"/>
            <Label Content="Tên đăng nhập" Margin="0,0,0,5" Padding="0" Foreground="#555"/>
            <TextBox x:Name="txtUsername" Height="32" Margin="0,0,0,15"
VerticalContentAlignment="Center" Padding="5,0"
Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Mật khẩu" Margin="0,0,0,5" Padding="0" Foreground="#555"/>
            <PasswordBox x:Name="txtPassword" Height="32" Margin="0,0,0,10"
VerticalContentAlignment="Center" Padding="5,0"/>
            <!-- TextBlock Hiển thị thông báo lỗi khi đăng nhập thất bại -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center"
Margin="0,0,0,15" FontWeight="SemiBold"/>
            <Button Content="Đăng nhập" Height="40" Background="#F4F4F4" BorderBrush="#D3D3D3"
FontWeight="SemiBold" FontSize="14"
Command="{Binding LoginCommand}" CommandParameter="{Binding
ElementName=txtPassword}"/>
        </StackPanel>
    </Grid>
</Window>
