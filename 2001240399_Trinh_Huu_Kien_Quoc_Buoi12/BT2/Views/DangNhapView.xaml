<Window x:Class="BT2.Views.DangNhapView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BT2.Views"
        mc:Ignorable="d"
        Title="DangNhapView" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             SIDEBAR MENU
        ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Tiêu đề hệ thống -->
                    <TextBlock Text="HỆ THỐNG CỬA HÀNG"
                               FontWeight="Bold" FontSize="14"
                               Margin="12,16,12,4" TextWrapping="Wrap"/>

                    <!-- Lời chào nhân viên đăng nhập -->
                    <TextBlock Text="{Binding GreetingMessage}"
                               FontSize="12" Foreground="#555"
                               Margin="12,0,12,16" TextWrapping="Wrap"/>

                    <Separator/>

                    <!-- ── Nhóm: Hệ thống ─────────────────────── -->
                    <Expander Header="⊙ Hệ thống" IsExpanded="True" Margin="4,6,4,0">
                        <StackPanel Margin="4,4,4,4">
                            <!-- Đổi mật khẩu: ai cũng có quyền khi đã đăng nhập -->
                            <Button Content="Đổi mật khẩu"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding IsQuanLy}"/>
                            <Button Content="Sao lưu"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding IsQuanLy}"/>
                            <Button Content="Phục hồi"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding IsQuanLy}"/>
                            <!-- Đăng xuất luôn active -->
                            <Button Content="Đăng xuất"
                                    Height="30" Margin="0,2"
                                    Command="{Binding LogoutCommand}"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Nhóm: Danh mục ─────────────────────── -->
                    <Expander Header="⊙ Danh mục" IsExpanded="True" Margin="4,6,4,0">
                        <StackPanel Margin="4,4,4,4">

                            <Button Content="Loại sản phẩm"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessDanhMuc}"/>
                            <Button Content="Sản phẩm"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessDanhMuc}"/>
                            <Button Content="Nhà cung cấp"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessDanhMuc}"/>
                            <Button Content="Nhân viên"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessDanhMuc}"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Nhóm: Nhập hàng ────────────────────── -->
                    <Expander Header="⊙ Nhập hàng" IsExpanded="True" Margin="4,6,4,0">
                        <StackPanel Margin="4,4,4,4">
   
                            <Button Content="Lập phiếu nhập"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessLapPhieuNhap}"
                                    Command="{Binding OpenLapPhieuNhapCommand}"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Nhóm: Thống kê ─────────────────────── -->
                    <Expander Header="⊙ Thống kê" IsExpanded="True" Margin="4,6,4,0">
                        <StackPanel Margin="4,4,4,4">
                            <Button Content="Thống kê tồn kho"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessThongKeTonKho}"/>
                            <Button Content="Thống kê nhập"
                                    Height="30" Margin="0,2"
                                    IsEnabled="{Binding CanAccessThongKeNhap}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
