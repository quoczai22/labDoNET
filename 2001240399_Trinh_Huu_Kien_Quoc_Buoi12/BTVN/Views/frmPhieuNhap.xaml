<Window x:Class="BTVN.Views.frmPhieuNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BTVN.Views"
        mc:Ignorable="d"
        Title="frmPhieuNhap" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="THÔNG TIN PHIẾU NHẬP" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Ngày nhập"/>
            <TextBox Text="{Binding NgayNhap}" IsEnabled="False" Height="25" Margin="0,5,0,15"/>

            <TextBlock Text="Nhà cung cấp"/>
            <ComboBox ItemsSource="{Binding DanhSachNhacc}" DisplayMemberPath="TENNCC" 
                  SelectedItem="{Binding SelectedNCC}" IsEnabled="{Binding IsNccEnabled}" 
                  Height="25" Margin="0,5,0,30"/>

            <TextBlock Text="TỔNG TIỀN" Foreground="Gray"/>
            <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} ₫}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,20"/>

            <Button Content="TẠO PHIẾU" Command="{Binding TaoPhieuCommand}" Visibility="{Binding BtnTaoPhieuVisibility}" 
                Height="35" Background="#1976D2" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CHI TIẾT PHIẾU NHẬP" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding DanhSachSP}" DisplayMemberPath="TENSANPHAM" SelectedItem="{Binding SelectedSP}" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
                <TextBox Grid.Column="2" Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
                <Button Grid.Column="3" Content="Thêm" Command="{Binding ThemCommand}"/>
            </Grid>

            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DanhSachChiTiet}" SelectedItem="{Binding SelectedChiTiet}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Xóa chi tiết này" Command="{Binding XoaCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sản phẩm" Binding="{Binding TenSanPham}" Width="*"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="LƯU PHIẾU" Command="{Binding LuuCommand}" Width="100" Height="30" Margin="0,0,10,0"/>
                <Button Content="HỦY" Command="{Binding HuyCommand}" Width="70" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
