<Window x:Class="Bai5.Views.QuanLySinhVienView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai5.Views"
        mc:Ignorable="d"
        Title="QuanLySinhVienView" Height="550" Width="900">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,10,0" Padding="15">
            <StackPanel>
                <TextBlock Text="THÔNG TIN SINH VIÊN" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Mã sinh viên:" Margin="0,5,0,5"/>
                <TextBox Height="28" VerticalContentAlignment="Center" Padding="5,0" 
                       Text="{Binding MaSV, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Họ tên:" Margin="0,15,0,5"/>
                <TextBox Height="28" VerticalContentAlignment="Center" Padding="5,0" 
                       Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Giới tính:" Margin="0,15,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="15,5,0,5">
                    <RadioButton Content="Nam" Margin="0,0,40,0" VerticalAlignment="Center" IsChecked="{Binding IsNam}"/>
                    <RadioButton Content="Nữ" VerticalAlignment="Center" IsChecked="{Binding IsNu}"/>
                </StackPanel>

                <TextBlock Text="Ngày sinh:" Margin="0,15,0,5"/>
                <DatePicker Height="28" VerticalContentAlignment="Center" 
                          SelectedDate="{Binding NgaySinh, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Lớp:" Margin="0,15,0,5"/>
                <ComboBox Height="28" VerticalContentAlignment="Center" 
                        ItemsSource="{Binding DS_Lop}" 
                        DisplayMemberPath="TenLop" 
                        SelectedValuePath="MaLop" 
                        SelectedValue="{Binding SelectedMaLop}"/>

                <UniformGrid Columns="5" Margin="0,30,0,0">
                    <Button Content="Thêm" Height="30" Margin="0,0,5,0" Command="{Binding ThemCommand}" Background="#E1E1E1"/>
                    <Button Content="Sửa" Height="30" Margin="0,0,5,0" Command="{Binding SuaCommand}" Background="#E1E1E1"/>
                    <Button Content="Xóa" Height="30" Margin="0,0,5,0" Command="{Binding XoaCommand}" Background="#E1E1E1"/>
                    <Button Content="Lưu" Height="30" Margin="0,0,5,0" Command="{Binding LuuCommand}" Background="#E1E1E1"/>
                    <Button Content="Hủy" Height="30" Command="{Binding HuyCommand}" Background="#E1E1E1"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10,0,0,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DANH SÁCH SINH VIÊN" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding DS_SinhVien}" SelectedItem="{Binding SelectedSinhVien}"
                        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="32" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSinhVien}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="5,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="5,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã lớp" Binding="{Binding MaLop}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="5,8"/>
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
