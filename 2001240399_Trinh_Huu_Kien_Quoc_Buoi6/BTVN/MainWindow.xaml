<Window x:Class="BTVN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BTVN.ViewModels"
        Title="Quản lý" Height="620" Width="1050">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Quản lý">
                <MenuItem Header="Nhân viên" Command="{Binding ShowEmployeeCommand}"/>
                <MenuItem Header="Tài khoản" Command="{Binding ShowAccountCommand}"/>
                <MenuItem Header="Sinh viên" Command="{Binding ShowStudentCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Margin="15">
            <Grid Visibility="{Binding IsEmployeeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DANH SÁCH NHÂN VIÊN" FontSize="18" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Grid Grid.Row="0" Margin="0,35,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mã NV:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5,20,5" Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Họ tên:" Grid.Row="0" Grid.Column="2" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,5" Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Địa chỉ:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,20,5" Text="{Binding EmployeeAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Chức vụ:" Grid.Row="1" Grid.Column="2" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,5" Text="{Binding EmployeePosition, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,20,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60"/>
                        <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeId}" Width="120"/>
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="240"/>
                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding Position}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Thêm" Width="80" Margin="5" Command="{Binding AddEmployeeCommand}"/>
                    <Button Content="Lưu" Width="80" Margin="5" Command="{Binding SaveEmployeeCommand}"/>
                    <Button Content="Sửa" Width="80" Margin="5" Command="{Binding EditEmployeeCommand}"/>
                    <Button Content="Xóa" Width="80" Margin="5" Command="{Binding DeleteEmployeeCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsAccountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DANH SÁCH TÀI KHOẢN NGÂN HÀNG" FontSize="18" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Grid Grid.Row="0" Margin="0,35,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Số TK:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5,20,5" Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Tên khách hàng:" Grid.Row="0" Grid.Column="2" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,5" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Địa chỉ:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,20,5" Text="{Binding AccountAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Thành phố:" Grid.Row="1" Grid.Column="2" Margin="0,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,5" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"/>
                    <TextBlock Text="Số tiền:" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5,20,5" Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,20,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60"/>
                        <DataGridTextColumn Header="Số TK" Binding="{Binding AccountNumber}" Width="120"/>
                        <DataGridTextColumn Header="Tên KH" Binding="{Binding CustomerName}" Width="220"/>
                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Thành phố" Binding="{Binding City}" Width="120"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Balance, StringFormat=N0}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Thêm" Width="80" Margin="5" Command="{Binding AddAccountCommand}"/>
                        <Button Content="Lưu" Width="80" Margin="5" Command="{Binding SaveAccountCommand}"/>
                        <Button Content="Sửa" Width="80" Margin="5" Command="{Binding EditAccountCommand}"/>
                        <Button Content="Xóa" Width="80" Margin="5" Command="{Binding DeleteAccountCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalBalance, StringFormat=Tổng tiền: {0:N0}}" Foreground="DarkRed" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsStudentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Danh sách lớp - sinh viên" Grid.Column="0">
                    <TreeView ItemsSource="{Binding Classes}" SelectedItemChanged="TreeView_SelectedItemChanged" Margin="10">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Students}">
                                <TextBlock Text="{Binding ClassName}" FontWeight="Bold"/>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" Margin="20,2,0,2"/>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="QUẢN LÝ LỚP HỌC" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <GroupBox Header="Chọn lớp" Margin="0,0,0,15">
                        <ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="ClassName" SelectedItem="{Binding SelectedClass}" Height="30" Margin="10"/>
                    </GroupBox>

                    <GroupBox Header="Thông tin sinh viên" Margin="0,0,0,15">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mã SV:" Grid.Row="0" Grid.Column="0" Margin="0,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6" Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Họ tên:" Grid.Row="1" Grid.Column="0" Margin="0,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Địa chỉ:" Grid.Row="2" Grid.Column="0" Margin="0,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Text="{Binding StudentAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Cập nhật" Width="110" Margin="5" Command="{Binding SaveStudentCommand}"/>
                                <Button Content="Xóa" Width="110" Margin="5" Command="{Binding DeleteStudentCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Thêm lớp">
                        <StackPanel Margin="10">
                            <CheckBox Content="Bật chế độ thêm lớp" IsChecked="{Binding IsAddClassMode}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="260" Text="{Binding NewClassName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAddClassMode}"/>
                                <Button Content="Thêm lớp" Width="120" Margin="15,0,0,0" Command="{Binding AddClassCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
