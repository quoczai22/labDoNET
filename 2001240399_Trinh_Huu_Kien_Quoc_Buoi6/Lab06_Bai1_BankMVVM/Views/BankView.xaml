<Window x:Class="Lab06_Bai1_BankMVVM.Views.BankView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab06_Bai1_BankMVVM.Views"
        xmlns:vm="clr-namespace:Lab06_Bai1_BankMVVM.ViewModels"
        mc:Ignorable="d"
        Title="BankView" Height="600" Width="980">
    <Window.DataContext>
        <vm:AccountViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="DANH SÁCH TÀI KHOẢN NGÂN HÀNG"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Số tài khoản:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox Grid.Row="0" Grid.Column="1"
                     Height="28"
                     Margin="0,5,15,5"
                     Text="{Binding InputAccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="Tên khách hàng:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox Grid.Row="0" Grid.Column="3"
                     Height="28"
                     Margin="0,5,0,5"
                     Text="{Binding InputCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Địa chỉ:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox Grid.Row="1" Grid.Column="1"
                     Height="28"
                     Margin="0,5,15,5"
                     Text="{Binding InputAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="Thành phố:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <ComboBox Grid.Row="1" Grid.Column="3"
                      Height="28"
                      Margin="0,5,0,5"
                      ItemsSource="{Binding Cities}"
                      SelectedItem="{Binding InputCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Số tiền:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox Grid.Row="2" Grid.Column="1"
                     Height="28"
                     Margin="0,5,15,5"
                     Text="{Binding InputBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <DataGrid Grid.Row="3"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT"
                                    Binding="{Binding STT}"
                                    Width="60"/>
                <DataGridTextColumn Header="Số TK"
                                    Binding="{Binding AccountNumber}"
                                    Width="120"/>
                <DataGridTextColumn Header="Tên KH"
                                    Binding="{Binding CustomerName}"
                                    Width="200"/>
                <DataGridTextColumn Header="Địa chỉ"
                                    Binding="{Binding Address}"
                                    Width="180"/>
                <DataGridTextColumn Header="Thành phố"
                                    Binding="{Binding City}"
                                    Width="120"/>
                <DataGridTextColumn Header="Số tiền"
                                    Binding="{Binding Balance, StringFormat=N0}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,10">
            <TextBlock Text="Tổng tiền: "
                       FontSize="15"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalBalance, StringFormat=N0}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="Firebrick"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="{Binding AddButtonText}"
                    Width="90" Height="32"
                    Margin="5"
                    Command="{Binding AddCommand}"/>

            <Button Content="Lưu"
                    Width="90" Height="32"
                    Margin="5"
                    Command="{Binding SaveCommand}"/>

            <Button Content="{Binding EditButtonText}"
                    Width="90" Height="32"
                    Margin="5"
                    Command="{Binding EditCommand}"/>

            <Button Content="Xóa"
                    Width="90" Height="32"
                    Margin="5"
                    Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</Window>
