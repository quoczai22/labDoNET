<Window x:Class="Bai2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai2.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="520" Width="900">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Phòng ban" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <TreeView ItemsSource="{Binding Departments}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          Height="260">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Employees}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" Margin="15,2,0,2"/>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock Text="Tên phòng ban mới:" Margin="0,15,0,5"/>
                <TextBox Text="{Binding NewDepartmentName, UpdateSourceTrigger=PropertyChanged}" Height="28"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Thêm phòng ban"
                            Width="120" Height="30" Margin="0,0,10,0"
                            Command="{Binding AddDepartmentCommand}"/>
                    <Button Content="Xóa phòng ban"
                            Width="120" Height="30"
                            Command="{Binding RemoveDepartmentCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Thêm nhân viên" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Phòng ban:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Height="28" Margin="0,5"
                              ItemsSource="{Binding Departments}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mã NV:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Height="28" Margin="0,5"
                             Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Họ tên:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Height="28" Margin="0,5"
                             Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Địa chỉ:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Height="28" Margin="0,5"
                             Text="{Binding EmployeeAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Button Content="Thêm"
                        Width="100" Height="30"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding AddEmployeeCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
