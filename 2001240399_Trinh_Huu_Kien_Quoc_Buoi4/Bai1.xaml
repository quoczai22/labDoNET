<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi4.Bai1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2001240399_Trinh_Huu_Kien_Quoc_Buoi4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <DockPanel x:Name="MainContent">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="He thong">
                <MenuItem Header="Dang nhap"/>
                <Separator/>
                <MenuItem Header="Thoat"
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="Danh muc">
                <MenuItem Header="NhanVien" Click="MenuNhanVien_Click"/>
                <Separator/>
                <MenuItem Header="PhongBan" Click="MenuPhongBan_Click"/>
            </MenuItem>
        </Menu>
        
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="🏠"/>
                <Button Content="+"/>
                <Button Content="👥"/>
                <Button Content="+"/>
                <Button Content="X"/>
            </ToolBar>
        </ToolBarTray>
    </DockPanel>
</Window>