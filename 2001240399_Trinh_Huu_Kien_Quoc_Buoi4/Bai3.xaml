<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi4.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2001240399_Trinh_Huu_Kien_Quoc_Buoi4"
        mc:Ignorable="d"
        Title="Bai3" Height="450" Width="800">
    <Grid>
        <DockPanel x:Name="MainContent">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Hệ thống">
                    <MenuItem Header="Đăng nhập"/>
                    <MenuItem Header="Đổi mật khẩu"/>
                    <Separator/>
                    <MenuItem Header="Thoát" Click="BtnThoat_Click" InputGestureText="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="Danh mục">
                    <MenuItem Header="Sinh viên" Click="MenuSinhVien_Click"/>
                    <Separator/>
                    <MenuItem Header="Lớp học" Click="MenuLopHoc_Click"/>
                </MenuItem>
            </Menu>

            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Content="Thêm" Click="BtnThem_Click"/>
                    <Button Content="Xóa" Click="BtnXoa_Click"/>
                    <Button Content="Thoát" Click="BtnThoat_Click"/>
                </ToolBar>
            </ToolBarTray>
        </DockPanel>
    </Grid>
</Window>
