<UserControl x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi4.ucSinhVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_2001240399_Trinh_Huu_Kien_Quoc_Buoi4"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Label Content="Mã SV:" Width="100"/>
            <TextBox x:Name="txtMaSV" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5">
            <Label Content="Họ tên:" Width="100"/>
            <TextBox x:Name="txtHoTen" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="5">
            <Label Content="Ngày sinh:" Width="100"/>
            <DatePicker x:Name="dpNgaySinh" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="5">
            <Label Content="Giới tính:" Width="100"/>
            <RadioButton x:Name="rbNam" Content="Nam" GroupName="GioiTinh"/>
            <RadioButton x:Name="rbNu" Content="Nữ" GroupName="GioiTinh" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="5">
            <Label Content="Sở thích:" Width="100"/>
            <CheckBox Content="Thể thao"/>
            <CheckBox Content="Âm nhạc" Margin="10,0,0,0"/>
            <CheckBox Content="Du lịch" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="5">
            <Label Content="Lớp học:" Width="100"/>
            <ComboBox x:Name="cbLop" Width="200">
                <ComboBoxItem Content="CNTT"/>
                <ComboBoxItem Content="Kế toán"/>
                <ComboBoxItem Content="Quản trị kinh doanh"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="6" Margin="5">
            <Label Content="Môn học:" Width="100"/>
            <ListBox x:Name="lbMonHoc" Width="300" Height="100" SelectionMode="Multiple">
                <ListBoxItem Content="Lập trình C#"/>
                <ListBoxItem Content="Cơ sở dữ liệu"/>
                <ListBoxItem Content="WPF nâng cao"/>
                <ListBoxItem Content="Mạng máy tính"/>
            </ListBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Center" Margin="5">
            <Button Content="Lưu" Width="80" Margin="5"/>
            <Button Content="Xóa" Width="80" Margin="5"/>
            <Button Content="Làm mới" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>
