<Window x:Class="WpfApp1.Bai2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Bai2" Height="742" Width="1018">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="487*"/>
            <ColumnDefinition Width="178*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Form Thông tin - Sở thích cá nhân"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="156,10,156,19.5" Foreground="#2C3E50"
                   Grid.ColumnSpan="2"/>

        <!-- TabControl -->
        <TabControl Grid.Row="1" x:Name="tabControl"
                    Background="White" Padding="10" Grid.ColumnSpan="2"
                    Margin="0,0.5,0,64.5" Grid.RowSpan="2">

            <!-- Tab 1: Nhập thông tin cá nhân -->
            <TabItem Header="Nhập thông tin cá nhân">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột 1 -->
                    <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Họ và tên:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtHoTen" Height="28" Margin="0,0,0,15"/>

                        <TextBlock Text="Giới tính:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton x:Name="radNam" Content="Nam" Margin="10,0"/>
                            <RadioButton x:Name="radNu" Content="Nữ" Margin="10,0"/>
                        </StackPanel>

                        <TextBlock Text="Ngày sinh:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dtpNgaySinh" Margin="0,0,0,15"/>

                        <TextBlock Text="Quốc tịch:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbQuocTich" Height="28" Margin="0,0,0,15">
                            <ComboBoxItem Content="Việt Nam"/>
                            <ComboBoxItem Content="Mỹ"/>
                            <ComboBoxItem Content="Nhật Bản"/>
                            <ComboBoxItem Content="Hàn Quốc"/>
                            <ComboBoxItem Content="Pháp"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Cột 2 -->
                    <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Nghề nghiệp:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNgheNghiep" Height="28" Margin="0,0,0,15"/>

                        <TextBlock Text="Sở thích:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Margin="0,0,0,15">
                            <CheckBox x:Name="chkDocSach" Content="Đọc sách" Margin="5"/>
                            <CheckBox x:Name="chkNgheNhac" Content="Nghe nhạc" Margin="5"/>
                            <CheckBox x:Name="chkTheThao" Content="Thể thao" Margin="5"/>
                            <CheckBox x:Name="chkDuLich" Content="Du lịch" Margin="5"/>
                        </StackPanel>

                        <TextBlock Text="Kỹ năng" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox x:Name="lstKyNang" Height="100" SelectionMode="Multiple" Margin="0,0,0,15">
                            <ListBoxItem Content="C# / .NET"/>
                            <ListBoxItem Content="WPF / XAML"/>
                            <ListBoxItem Content="SQL Server"/>
                            <ListBoxItem Content="HTML / CSS"/>
                            <ListBoxItem Content="Kỹ thuật lập trình"/>
                        </ListBox>

                        <TextBlock Text="Ghi chú:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtGhiChu" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Xem thông tin -->
            <TabItem Header="Xem thông tin">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột 1 -->
                    <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Họ và tên:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblHoTen" Margin="0,0,0,10"/>

                        <TextBlock Text="Giới tính:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblGioiTinh" Margin="0,0,0,10"/>

                        <TextBlock Text="Ngày sinh:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblNgaySinh" Margin="0,0,0,10"/>

                        <TextBlock Text="Quốc tịch:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblQuocTich" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Cột 2 -->
                    <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Nghề nghiệp:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblNgheNghiep" Margin="0,0,0,10"/>

                        <TextBlock Text="Sở thích:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblSoThich" Margin="0,0,0,10"/>

                        <TextBlock Text="Kỹ năng:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblKyNang" Margin="0,0,0,10"/>

                        <TextBlock Text="Ghi chú:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblGhiChu" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Nút cuối cùng -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="218,20.5,39.078,10.5">
            <Button Content="Xem thông tin" Width="130" Height="35" Background="#3498DB" Foreground="White" Click="BtnXemThongTin_Click"/>
            <Button Content="Thoát" Width="100" Height="35" Background="#E74C3C" Foreground="White" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
