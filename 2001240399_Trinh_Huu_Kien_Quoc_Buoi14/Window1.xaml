<Window x:Class="_2001240399_Trinh_Huu_Kien_Quoc_Buoi14.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab 14 - Báo cáo có tham số" Height="650" Width="1000"
        Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BÁO CÁO LAB 14 - CÓ THAM SỐ" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Chức năng:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cboLoaiBaoCao" Width="230" Height="30" Margin="10,0,20,0" SelectionChanged="cboLoaiBaoCao_SelectionChanged">
                        <ComboBoxItem Content="Sinh viên theo lớp" Tag="SinhVienTheoLop" IsSelected="True"/>
                        <ComboBoxItem Content="Điểm theo lớp học" Tag="DiemTheoLop"/>
                        <ComboBoxItem Content="Lớp theo khoa" Tag="LopTheoKhoa"/>
                    </ComboBox>
                    <Label x:Name="lblLop" Content="Lớp:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cboLop" Width="220" Height="30" Margin="10,0,20,0" DisplayMemberPath="TenHienThi" SelectedValuePath="MaLop"/>
                    <Label x:Name="lblKhoa" Content="Khoa:" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed"/>
                    <ComboBox x:Name="cboKhoa" Width="220" Height="30" Margin="10,0,20,0" DisplayMemberPath="TenKhoa" SelectedValuePath="MaKhoa" Visibility="Collapsed"/>
                    <Button x:Name="btnShowReport" Content="Show Report" Width="120" Height="30" Click="btnShowReport_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
            <GroupBox.Header>
                <TextBlock x:Name="txtTieuDe" Text="DANH SÁCH SINH VIÊN THEO LỚP" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0"/>
            </GroupBox.Header>
            <DataGrid x:Name="dgBaoCao" Margin="10" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All"/>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="txtTrangThai" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#555"/>
            <Button Content="Xem in" Width="90" Height="32" Margin="4,0" Click="btnXemIn_Click"/>
            <Button Content="Đóng" Width="90" Height="32" Margin="4,0" Click="btnDong_Click"/>
        </StackPanel>
    </Grid>
</Window>
