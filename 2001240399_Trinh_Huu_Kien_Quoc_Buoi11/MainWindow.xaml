<Window x:Class="_2001240399_TrinhHuuKienQuoc_Buoi11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:_2001240399_TrinhHuuKienQuoc_Buoi11.ViewModels"
        Title="Lab 11 - Quản lý sinh viên" Height="620" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,1,0">
            <StackPanel Margin="14">
                <TextBlock Text="LAB 11" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                <TextBlock Text="Danh mục" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,6"/>
                <Button Content="Khoa" Height="34" Margin="0,0,0,6" Command="{Binding ShowKhoaCommand}"/>
                <Button Content="Lớp" Height="34" Margin="0,0,0,6" Command="{Binding ShowLopCommand}"/>
                <Button Content="Môn học" Height="34" Margin="0,0,0,16" Command="{Binding ShowMonHocCommand}"/>
                <TextBlock Text="Quản lý" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,6"/>
                <Button Content="Sinh viên" Height="34" Command="{Binding ShowSinhVienCommand}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
