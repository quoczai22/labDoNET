<UserControl x:Class="_2001240399_TrinhHuuKienQuoc_Buoi11.Views.KhoaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="THÔNG TIN KHOA" Margin="0,0,15,0">
            <StackPanel Margin="15">
                <Label Content="Mã khoa:"/>
                <TextBox Text="{Binding MaKhoa, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Tên khoa:"/>
                <TextBox Text="{Binding TenKhoa, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <UniformGrid Rows="1" Columns="5" Margin="0,16,0,0">
                    <Button Content="Thêm" Margin="0,0,6,0" Command="{Binding ThemCommand}"/>
                    <Button Content="Sửa" Margin="0,0,6,0" Command="{Binding SuaCommand}"/>
                    <Button Content="Xóa" Margin="0,0,6,0" Command="{Binding XoaCommand}"/>
                    <Button Content="Lưu" Margin="0,0,6,0" Command="{Binding LuuCommand}"/>
                    <Button Content="Hủy" Command="{Binding HuyCommand}"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="DANH SÁCH KHOA">
            <DataGrid Margin="10" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding DS_Khoa}" SelectedItem="{Binding SelectedKhoa, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã khoa" Binding="{Binding MaKhoa}" Width="120"/>
                    <DataGridTextColumn Header="Tên khoa" Binding="{Binding TenKhoa}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
