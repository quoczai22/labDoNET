<UserControl x:Class="_2001240399_TrinhHuuKienQuoc_Buoi11.Views.MonHocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="THÔNG TIN MÔN HỌC" Margin="0,0,15,0">
            <StackPanel Margin="15">
                <Label Content="Mã môn:"/>
                <TextBox Text="{Binding MaMon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Tên môn:"/>
                <TextBox Text="{Binding TenMon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Số tín chỉ:"/>
                <TextBox Text="{Binding SoTinChi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <UniformGrid Rows="1" Columns="5" Margin="0,16,0,0">
                    <Button Content="Thêm" Margin="0,0,6,0" Command="{Binding ThemCommand}"/>
                    <Button Content="Sửa" Margin="0,0,6,0" Command="{Binding SuaCommand}"/>
                    <Button Content="Xóa" Margin="0,0,6,0" Command="{Binding XoaCommand}"/>
                    <Button Content="Lưu" Margin="0,0,6,0" Command="{Binding LuuCommand}"/>
                    <Button Content="Hủy" Command="{Binding HuyCommand}"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="DANH SÁCH MÔN HỌC">
            <DataGrid Margin="10" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding DS_MonHoc}" SelectedItem="{Binding SelectedMonHoc, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMon}" Width="110"/>
                    <DataGridTextColumn Header="Tên môn" Binding="{Binding TenMon}" Width="*"/>
                    <DataGridTextColumn Header="Số TC" Binding="{Binding SoTinChi}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
