<UserControl x:Class="Lab11_ValidationNavigation.Views.MonHocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quan ly Mon hoc" FontSize="26" FontWeight="Bold" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ma mon" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding NewMonHoc.MaMon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Column="2" Text="Ten mon" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" Text="{Binding NewMonHoc.TenMon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="So tin chi" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewMonHoc.SoTinChi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Them" Command="{Binding AddCommand}"/>
                <Button Content="Cap nhat" Command="{Binding UpdateCommand}"/>
                <Button Content="Xoa" Command="{Binding DeleteCommand}"/>
                <Button Content="Nhap lai" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding DS_MonHoc}" SelectedItem="{Binding SelectedMonHoc}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ma mon" Binding="{Binding MaMon}" Width="150"/>
                <DataGridTextColumn Header="Ten mon" Binding="{Binding TenMon}" Width="*"/>
                <DataGridTextColumn Header="So tin chi" Binding="{Binding SoTinChi}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
