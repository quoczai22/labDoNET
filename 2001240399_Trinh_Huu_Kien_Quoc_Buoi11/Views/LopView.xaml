<UserControl x:Class="_2001240399_TrinhHuuKienQuoc_Buoi11.Views.LopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="THÔNG TIN LỚP" Margin="0,0,15,0">
            <StackPanel Margin="15">
                <Label Content="Mã lớp:"/>
                <TextBox Text="{Binding MaLop, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaLop}" Value="">
                                    <Setter Property="Background" Value="AliceBlue"/>
                                    <Setter Property="ToolTip" Value="Mã lớp không trống"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MaLop}" Value="{x:Null}">
                                    <Setter Property="Background" Value="AliceBlue"/>
                                    <Setter Property="ToolTip" Value="Mã lớp không trống"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Label Content="Tên lớp:"/>
                <TextBox Text="{Binding TenLop, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Khoa:"/>
                <ComboBox ItemsSource="{Binding DS_Khoa}" SelectedValuePath="MaKhoa" DisplayMemberPath="TenKhoa" SelectedValue="{Binding MaKhoa}"/>
                <UniformGrid Rows="1" Columns="5" Margin="0,16,0,0">
                    <Button Content="Thêm" Margin="0,0,6,0" Command="{Binding ThemCommand}"/>
                    <Button Content="Sửa" Margin="0,0,6,0" Command="{Binding SuaCommand}"/>
                    <Button Content="Xóa" Margin="0,0,6,0" Command="{Binding XoaCommand}"/>
                    <Button Content="Lưu" Margin="0,0,6,0" Command="{Binding LuuCommand}"/>
                    <Button Content="Hủy" Command="{Binding HuyCommand}"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="DANH SÁCH LỚP">
            <Grid Margin="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                          ItemsSource="{Binding DS_Lop}" SelectedItem="{Binding SelectedLop, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã lớp" Binding="{Binding MaLop}" Width="100"/>
                        <DataGridTextColumn Header="Tên lớp" Binding="{Binding TenLop}" Width="*"/>
                        <DataGridTextColumn Header="Mã khoa" Binding="{Binding MaKhoa}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Chưa có dữ liệu lớp" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DS_Lop.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
