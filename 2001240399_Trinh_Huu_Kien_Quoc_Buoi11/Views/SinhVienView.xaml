<UserControl x:Class="_2001240399_TrinhHuuKienQuoc_Buoi11.Views.SinhVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="THÔNG TIN SINH VIÊN" Margin="0,0,15,0">
            <StackPanel Margin="15">
                <Label Content="Mã sinh viên:"/>
                <TextBox IsReadOnly="{Binding IsMaSVReadOnly}" Text="{Binding MaSV, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Họ tên:"/>
                <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Giới tính:"/>
                <ComboBox ItemsSource="{Binding DS_GioiTinh}" SelectedItem="{Binding GioiTinh, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Ngày sinh:"/>
                <DatePicker SelectedDate="{Binding NgaySinh, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <Label Content="Lớp:"/>
                <ComboBox ItemsSource="{Binding DS_Lop}" SelectedValuePath="MaLop" DisplayMemberPath="TenLop" SelectedValue="{Binding MaLop, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <UniformGrid Rows="1" Columns="5" Margin="0,16,0,0">
                    <Button Content="Thêm" Margin="0,0,6,0" Command="{Binding ThemCommand}"/>
                    <Button Content="Sửa" Margin="0,0,6,0" Command="{Binding SuaCommand}"/>
                    <Button Content="Xóa" Margin="0,0,6,0" Command="{Binding XoaCommand}"/>
                    <Button Content="Lưu" Margin="0,0,6,0" Command="{Binding LuuCommand}"/>
                    <Button Content="Hủy" Command="{Binding HuyCommand}"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="DANH SÁCH SINH VIÊN">
            <DataGrid Margin="10" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding DS_SinhVien}" SelectedItem="{Binding SelectedSinhVien, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="90"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="80"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Mã lớp" Binding="{Binding MaLop}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
